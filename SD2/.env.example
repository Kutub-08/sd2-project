# Groq AI (recommendations / similar listings)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL connection string
DATABASE_URL="postgres://user:pass@localhost:5432/tolet?sslmode=require"

# Cloudinary (listing image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT secrets (use long random strings)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Server
PORT=3000

# Frontend origin (used to build password reset links)
CLIENT_URL=http://localhost:5173

# SMTP (password reset email). Leave SMTP_HOST empty to fall back to
# logging the reset link in the dev console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=To-Let <no-reply@to-let.local>